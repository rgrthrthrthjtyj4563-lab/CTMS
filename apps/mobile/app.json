{
  "expo": {
    "name": "AIC-DCT Subject",
    "slug": "aic-dct-subject",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aic-dct-subject",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aicdct.subject"
    },
    "android": {
      "package": "com.aicdct.subject"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://127.0.0.1:4000"
    }
  }
}