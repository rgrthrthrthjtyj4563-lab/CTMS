generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  projects Project[]
}

model User {
  id             String   @id @default(cuid())
  phone          String   @unique
  passwordHash   String
  name           String
  role           String   // CRA, PM, QA, ADMIN
  organizationId String
  preferredProjectId String?
  preferredSiteId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  assignments  UserAssignment[]
  sessions     Session[]

  monitoringVisitsAsCra MonitoringVisit[] @relation("CraVisits")
  inputs                VisitInput[]
  actionPacks           ActionPack[]
  hoursRecords          HoursRecord[]
  issuesReported        Issue[]           @relation("IssueReporter")
  todos                 Todo[]
  auditEvents           AuditEvent[]
  reviews               Review[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id             String   @id @default(cuid())
  code           String
  name           String
  organizationId String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  sites            Site[]
  assignments      UserAssignment[]
  monitoringVisits MonitoringVisit[]
  hoursRecords     HoursRecord[]
  issues           Issue[]
}

model Site {
  id        String   @id @default(cuid())
  projectId String
  code      String
  name      String
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project          Project           @relation(fields: [projectId], references: [id])
  assignments      UserAssignment[]
  monitoringVisits MonitoringVisit[]
  hoursRecords     HoursRecord[]
  issues           Issue[]
}

model UserAssignment {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  siteId    String?
  role      String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, siteId])
}

model MonitoringVisit {
  id              String    @id @default(cuid())
  projectId       String
  siteId          String
  craId           String
  type            String    // SIV, IMV, COV
  status          String    @default("PLANNED")
  plannedDate     DateTime
  actualStartTime DateTime?
  actualEndTime   DateTime?
  subjectsReviewed Int?
  workSummary     String?
  sitePersonnel   String?   // JSON array
  findings        String?   // JSON array
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project      Project        @relation(fields: [projectId], references: [id])
  site         Site           @relation(fields: [siteId], references: [id])
  cra          User           @relation("CraVisits", fields: [craId], references: [id])
  inputs       VisitInput[]
  activities   VisitActivity[]
  attachments  Attachment[]
  actionPacks  ActionPack[]
  hoursRecords HoursRecord[]
  issues       Issue[]
  todos        Todo[]
  reportDraft  ReportDraft?
  followUpItems FollowUpItem[]
}

model VisitInput {
  id                String   @id @default(cuid())
  monitoringVisitId String
  userId            String
  type              String   // TEXT, VOICE, IMAGE, FILE
  content           String
  transcript        String?
  status            String   @default("COMPLETED") // COMPLETED, EDITED, VOIDED
  clientInputId     String?  // for offline sync
  syncStatus        String   @default("SYNCED")
  version           Int      @default(1)
  originalContent   String?  // first version content before any edit
  editReason        String?
  isVoided          Boolean  @default(false)
  voidedAt          DateTime?
  voidReason        String?
  voidedById        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  monitoringVisit MonitoringVisit @relation(fields: [monitoringVisitId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])
}

/// Structured visit activity checklist (replaces free-form "记录节点")
model VisitActivity {
  id                String   @id @default(cuid())
  monitoringVisitId String
  activityType      String   // e.g. SOURCE_DATA_REVIEW, DRUG_ACCOUNTABILITY
  title             String
  status            String   @default("PENDING") // PENDING, DONE, PARTIAL, NA
  note              String?
  sortOrder         Int      @default(0)
  relatedIssueIds   String?  // JSON array
  evidenceIds       String?  // JSON array of attachment ids
  sourceInputId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  monitoringVisit MonitoringVisit @relation(fields: [monitoringVisitId], references: [id], onDelete: Cascade)

  @@index([monitoringVisitId])
}

model Attachment {
  id                String   @id @default(cuid())
  monitoringVisitId String?
  userId            String?
  fileName          String
  mimeType          String
  filePath          String
  fileSize          Int
  fileType          String?
  sensitiveFlag     Boolean  @default(false)
  confirmed         Boolean  @default(false)
  clientAttachmentId String?
  syncStatus        String   @default("SYNCED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  monitoringVisit MonitoringVisit? @relation(fields: [monitoringVisitId], references: [id], onDelete: SetNull)
}

model ActionPack {
  id                String   @id @default(cuid())
  monitoringVisitId String
  userId            String
  status            String   @default("DRAFT")
  summary           String?  // JSON
  warnings          String?  // JSON array
  followUpQuestions String?  // JSON array
  modelInfo         String?  // JSON: { origin, model, generatedAt }
  isActive          Boolean  @default(true) // only one active pack per visit
  submittedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  monitoringVisit MonitoringVisit @relation(fields: [monitoringVisitId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])
  items           ActionItem[]
  reviews         Review[]

  @@index([monitoringVisitId, isActive])
}

model ActionItem {
  id           String   @id @default(cuid())
  actionPackId String
  type         String
  title        String
  description  String?
  data         String   // JSON
  status       String   @default("SUGGESTED")
  sourceIds    String?  // JSON: { inputIds, attachmentIds, sources[], origin }
  origin       String   @default("RULE") // MODEL | RULE | MANUAL
  requiresIndividualConfirm Boolean @default(false)
  blockingReason String?
  confirmedAt  DateTime?
  savedEntityId String? // id of created HoursRecord, Issue, etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actionPack ActionPack @relation(fields: [actionPackId], references: [id], onDelete: Cascade)
}

model HoursRecord {
  id                String   @id @default(cuid())
  userId            String
  projectId         String
  siteId            String?
  monitoringVisitId String?
  date              DateTime
  workType          String
  startTime         String?
  endTime           String?
  durationHours     Float
  description       String
  status            String   @default("DRAFT_CANDIDATE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  project         Project          @relation(fields: [projectId], references: [id])
  site            Site?            @relation(fields: [siteId], references: [id])
  monitoringVisit MonitoringVisit? @relation(fields: [monitoringVisitId], references: [id])
}

model Issue {
  id                String   @id @default(cuid())
  projectId         String
  siteId            String
  monitoringVisitId String?
  reporterId        String
  title             String
  description       String
  category          String
  severity          String
  subjectId         String?
  responsiblePerson String?
  targetDate        DateTime?
  requiredEvidence  String?
  status            String   @default("DRAFT_CANDIDATE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id])
  site            Site             @relation(fields: [siteId], references: [id])
  monitoringVisit MonitoringVisit? @relation(fields: [monitoringVisitId], references: [id])
  reporter        User             @relation("IssueReporter", fields: [reporterId], references: [id])
  todos           Todo[]
}

model Todo {
  id                String    @id @default(cuid())
  userId            String
  title             String
  description       String?
  group             String
  status            String    @default("OPEN")
  dueDate           DateTime?
  sourceType        String?
  sourceId          String?
  projectId         String?
  siteId            String?
  monitoringVisitId String?
  issueId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  user            User             @relation(fields: [userId], references: [id])
  monitoringVisit MonitoringVisit? @relation(fields: [monitoringVisitId], references: [id])
  issue           Issue?           @relation(fields: [issueId], references: [id])
}

model ReportDraft {
  id                String   @id @default(cuid())
  monitoringVisitId String   @unique
  title             String
  sections          String   // JSON array
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  monitoringVisit MonitoringVisit @relation(fields: [monitoringVisitId], references: [id], onDelete: Cascade)
}

model FollowUpItem {
  id                String   @id @default(cuid())
  monitoringVisitId String
  item              String
  responsiblePerson String
  dueDate           DateTime
  requiredEvidence  String?
  relatedIssueTitle String?
  suggestedWording  String?
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  monitoringVisit MonitoringVisit @relation(fields: [monitoringVisitId], references: [id], onDelete: Cascade)
}

model Review {
  id           String   @id @default(cuid())
  actionPackId String
  reviewerId   String
  decision     String   // APPROVE, RETURN, ESCALATE_QA
  comment      String?
  returnItems  String?  // JSON: specific items returned
  createdAt    DateTime @default(now())

  actionPack ActionPack @relation(fields: [actionPackId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id])
}

model AuditEvent {
  id         String   @id @default(cuid())
  type       String
  userId     String?
  entityType String
  entityId   String
  payload    String?  // JSON
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model OfflineDraft {
  id         String   @id @default(cuid())
  clientId   String
  userId     String
  entityType String
  entityId   String?
  payload    String   // JSON
  syncStatus String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId, userId])
}