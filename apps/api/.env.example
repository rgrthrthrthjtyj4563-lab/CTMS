DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=3001
HOST=0.0.0.0
UPLOAD_DIR=./uploads

# Text LLM — action pack generation (OpenAI-compatible, e.g. DeepSeek)
TEXT_LLM_API_KEY=
TEXT_LLM_BASE_URL=https://api.deepseek.com/v1
TEXT_LLM_MODEL=deepseek-chat

# Multimodal LLM — image evidence / sensitive info (Anthropic-compatible, e.g. MiniMax)
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=https://api.minimaxi.com/anthropic
MULTIMODAL_MODEL=MiniMax-M2.5

# Speech-to-text (ByteDance OpenSpeech ASR, NOT TTS)
ASR_API_KEY=
ASR_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# Legacy aliases (optional fallback)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# Demo mode — force rule-based action-pack generation for stable investor demos.
# When set, the API ignores TEXT_LLM_API_KEY and always uses parseWithRules().
# Activation: DEMO_MODE=1 | true | yes | on  OR  DEMO_PROFILE=demo
DEMO_MODE=
DEMO_PROFILE=